{
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "examples": [
        ""
      ]
    },
    "author": {
      "type": "string",
      "examples": [
        "your_name"
      ]
    },
    "title": {
      "type": "string",
      "examples": [
        "your_title"
      ]
    },
    "rating": {
      "type": "integer",
      "examples": [
        0,
        1,
        2,
        3
      ]
    },
    "warnings": {
      "type": "string",
      "examples": [
        "your_warnings"
      ]
    },
    "credits": {
      "type": "string",
      "examples": [
        "your_credits"
      ]
    },
    "links": {
      "type": "string",
      "examples": [
        "your_links",
        "https://benheroblaw.github.io/"
      ],
      "format": "uri"
    }
  },
  "required": [
    "rating"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}