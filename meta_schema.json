{
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "examples": [
        "your_title"
      ]
    },
    "$schema": {
      "type": "string",
      "examples": [
        "https://benheroblaw.github.io/meta_schema.json"
      ],
      "format": "uri"
    },
    "rating": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3,
      "description": "Rating between 0 and 3. 0 - General Audiences, 1 - Teen, 2 - Explicit, 3 - Adult",
      "examples": [
        0,
        1,
        2,
        3
      ]
    },
    "warnings": {
      "type": "string",
      "examples": [
        "your_warnings"
      ]
    },
    "author": {
      "type": "string",
      "examples": [
        "your_name"
      ]
    },
    "links": {
      "type": "string",
      "examples": [
        "your_links",
        "https://benheroblaw.github.io/"
      ],
      "format": "uri"
    },
    "credits": {
      "type": "string",
      "examples": [
        "your_credits"
      ]
    },
    "description": {
      "type": "string",
      "examples": [
        "your_description"
      ]
    },
    "tags": {
      "type": "array",
      "examples": [
        [
          "your_tags"
        ]
      ]
    }
  },
  "required": [
    "rating"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}